import { Util, Theme } from "../../def.slint";
import {
    Checkerboard,
    ComponentPosition,
    ExampleComponent,
} from "../../../base/widgets.slint";

export component CheckerboardExample inherits Flickable {
    viewport-height: vbox.preferred-height;
    viewport-width: vbox.preferred-width;
    interactive: false; // disable dragging

    vbox := VerticalLayout {
        spacing: Theme.spacing * 20;
        padding-top: Theme.padding * 5;
        padding-bottom: Theme.padding * 5;
        alignment: LayoutAlignment.center;

        // Default 8x8 checkerboard
        HorizontalLayout {
            width: root.width;
            alignment: LayoutAlignment.center;
            padding-top: Theme.padding * 10;

            ExampleComponent {
                width: Math.min(1000px, root.width * 0.8);

                HorizontalLayout {
                    Checkerboard {
                        width: 200px;
                        height: 200px;
                    }
                }

                code: "Checkerboard { width: 200px; height: 200px; }";
            }
        }

        // Custom 4x6 checkerboard with custom colors
        HorizontalLayout {
            width: root.width;
            alignment: LayoutAlignment.center;

            ExampleComponent {
                width: Math.min(1000px, root.width * 0.8);

                HorizontalLayout {
                    Checkerboard {
                        width: 240px;
                        height: 160px;
                        row-count: 4;
                        col-count: 6;
                        light-color: #FFFFFF;
                        dark-color: #333333;
                    }
                }

                code: "Checkerboard { width: 240px; height: 160px; row-count: 4; col-count: 6; light-color: #FFFFFF; dark-color: #333333; }";
            }
        }

        // 10x10 checkerboard
        HorizontalLayout {
            width: root.width;
            alignment: LayoutAlignment.center;

            ExampleComponent {
                width: Math.min(1000px, root.width * 0.8);

                HorizontalLayout {
                    Checkerboard {
                        width: 300px;
                        height: 300px;
                        row-count: 10;
                        col-count: 10;
                        light-color: Theme.brand-color;
                        dark-color: Theme.secondary-brand-color;
                    }
                }

                code: "Checkerboard { width: 300px; height: 300px; row-count: 10; col-count: 10; light-color: Theme.brand-color; dark-color: Theme.secondary-brand-color; }";
            }
        }
    }
}

