import { Util, Theme, Icons, Logic } from "../../def.slint";
import {
    ExampleComponent,
} from "../../../base/widgets.slint";
import { SoundWaveForm } from "../../../base/sound-wave-form.slint";

export component SoundWaveFormExample inherits Flickable {
    viewport-height: vbox.preferred-height;
    viewport-width: vbox.preferred-width;
    interactive: false; // disable dragging

