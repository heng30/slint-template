    vbox := VerticalLayout {
        spacing: Theme.spacing * 20;
        padding-top: Theme.padding * 5;
        padding-bottom: Theme.padding * 5;
        alignment: LayoutAlignment.center;

        // Basic Wave Form Example
        HorizontalLayout {
            width: root.width;
            alignment: LayoutAlignment.center;

            ExampleComponent {
                width: Math.min(1000px, root.width * 0.8);

                VerticalLayout {
                    spacing: Theme.spacing * 10;

                    Text {
                        text: "Interactive Wave - Drag to pan, buttons to zoom";
                        font-size: Theme.title4-font-size;
                        color: Theme.primary-text-color;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    wave-display := SoundWaveForm {
                        width: Math.min(1000px, root.width * 0.8);
                        wave-data: sine-wave-data;
                        wave-color: Theme.brand-color;
                        background: Theme.secondary-background;

                        move(precent) => {
                            debug(precent);
                        }
                    }
                }

                code: "SoundWaveForm {\n    height: 200px;\n    wave-data: sineWaveData; // Float array\n}";
            }
        }

        // Customized Style Example
        HorizontalLayout {
            width: root.width;
            alignment: LayoutAlignment.center;

            ExampleComponent {
                width: Math.min(1000px, root.width * 0.8);

                VerticalLayout {
                    spacing: Theme.spacing * 10;

                    Text {
                        text: "Square Wave with Grid";
                        font-size: Theme.title4-font-size;
                        color: Theme.primary-text-color;
                        horizontal-alignment: center;
                    }

                    SoundWaveForm {
                        width: Math.min(1000px, root.width * 0.8);
                        wave-data: square-wave-data;
                        wave-color: Theme.success-color;
                        background: Theme.thirdly-background;
                        amplitude-scale: 1.5;
                    }
                }

                code: "SoundWaveForm {\n    height: 150px;\n    wave-data: squareWaveData;\n    wave-color: Theme.success-color;\n    show-grid: true;\n    amplitude-scale: 1.5;\n}";
            }
        }

        // Noise Example
        HorizontalLayout {
            width: root.width;
            alignment: LayoutAlignment.center;

            ExampleComponent {
                width: Math.min(1000px, root.width * 0.8);

                VerticalLayout {
                    spacing: Theme.spacing * 10;

                    Text {
                        text: "Random Noise (Amplitude 2x)";
                        font-size: Theme.title4-font-size;
                        color: Theme.primary-text-color;
                        horizontal-alignment: center;
                    }

                    SoundWaveForm {
                        width: Math.min(1000px, root.width * 0.8);
                        wave-data: noise-data;
                        wave-color: Theme.danger-color;
                        amplitude-scale: 2.0;
                    }
                }

                code: "SoundWaveForm {\n    height: 150px;\n    wave-data: noiseData;\n    amplitude-scale: 2.0;  // Scale amplitude\n}";
