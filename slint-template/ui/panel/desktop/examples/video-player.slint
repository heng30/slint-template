import { Util, Theme, Icons } from "../../def.slint";
import {
    VideoPlayer,
    ExampleComponent,
    Label,
} from "../../../base/widgets.slint";

export component VideoPlayerExample inherits Flickable {
    viewport-height: vbox.preferred-height;
    viewport-width: vbox.preferred-width;
    interactive: false; // disable dragging

    vbox := VerticalLayout {
        spacing: Theme.spacing * 20;
        padding-top: Theme.padding * 5;
        padding-bottom: Theme.padding * 5;
        alignment: LayoutAlignment.center;

        HorizontalLayout {
            width: root.width;
            alignment: LayoutAlignment.center;

            ec := ExampleComponent {
                width: Math.min(1000px, root.width * 0.8);

                HorizontalLayout {
                    alignment: LayoutAlignment.center;

                    VideoPlayer {
                        height: 500px;
                        width: 80%;
                        show-speed-btn: false;
                        show-subtitle-btn: false;
                        show-full-screen-btn: false;
                        current-playlist-index: 0;
                        playlist-items: [
                            { title: "Video 1 - Short Title", duration: "3:45" },
                            { title: "Video 4 - Test Item", duration: "1:15" },
                            { title: "Video 5 - Another Test", duration: "4:20" },
                            { title: "Video 6 - Sample Video", duration: "2:45" },
                        ];
                    }
                }

                detail: "callback prev();\ncallback next();\ncallback play();\ncallback stop();\ncallback forward();\ncallback backward();\ncallback full-screen();\ncallback exit-full-screen();\ncallback sound-changed(sound: int);\ncallback speed-changed(speed: float);\ncallback progress-changed(progress: float);\ncallback playlist-item-selected(index: int);\ncallback key-pressed(key-event: KeyEvent);";

                code: "VideoPlayer {\n    height: 500px;\n    width: 80%;\n    show-speed-btn: false;\n    show-subtitle-btn: false;\n    show-full-screen-btn: false;\n    current-playlist-index: 0;\n    playlist-items: [\n        { title: \"Video 1 - Short Title\", duration: \"3:45\" },\n        { title: \"Video 4 - Test Item\", duration: \"1:15\" },\n        { title: \"Video 5 - Another Test\", duration: \"4:20\" },\n        { title: \"Video 6 - Sample Video\", duration: \"2:45\" },\n    ];\n}";
            }
        }
    }
}
