import { Theme } from "theme.slint";
import { Store } from "../store.slint";
import { Logic } from "../logic.slint";
import { Dialog } from "./dialog.slint";
import { LineInput } from "line-input.slint";

export component InputDialog inherits Dialog {
    title: Logic.tr("Input");
    is-prevent-event-forward: true;

    in-out property text <=> line-input.text;
    in-out property placeholder-text <=> line-input.placeholder-text;

    callback accepted(text: string);

    confirmed => {
        accepted(root.text);
    }

    canceled => {
        self.escape();
    }

    Timer {
        private property <bool> is-running: true;

        interval: 200ms;
        running: is-running;
        triggered() => {
            is-running = false;
            line-input.focus();
        }
    }

    VerticalLayout {
        padding: Theme.padding * 2;
        padding-top: Theme.padding * 4;

        line-input := LineInput {
            accepted => {
                root.accepted(root.text);
            }
        }
    }
}
